# copy to .env (gitignored) and fill in
HAVOICE_HOST=home-assistant-voice-0ae0b7.local
# base64 Noise PSK - see README "Getting the API key"
HAVOICE_KEY=
# HAVOICE_SERIAL=/dev/cu.usbmodem3101   # Linux: /dev/ttyACM0 (auto-detected when unset)
# HAVOICE_TTS=espeak-ng                 # speech program: say (macOS default), espeak-ng (Linux default), espeak
# HAVOICE_TTS_VOICE=cs                  # espeak voice/language
